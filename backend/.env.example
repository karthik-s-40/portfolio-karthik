# Cloud LLM API Key (Recommended for free cloud hosting on Render/Railway)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=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

# Cloud Generation Model (Default: llama-3.1-8b-instant or qwen-2.5-32b)
GROQ_MODEL=llama-3.1-8b-instant

# (Optional) Hugging Face API Token for free remote all-MiniLM-L6-v2 embeddings
# If not provided, public HF inference endpoint or local fallback will be used
HF_TOKEN=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

# Allowed CORS Origins (comma-separated list of frontends)
# Add your Vercel URL here in production:
# e.g.: https://portfolio-karthik.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://frontend-gamma-eight-31.vercel.app/

# Server Port (Auto-assigned by Render/Railway via $PORT, defaults to 8000)
PORT=8000
